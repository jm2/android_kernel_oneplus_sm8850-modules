# Magcvr cluster dispatcher: 3 modules from one M= dir
# (Bazel defines a 4th, oplus_magcvr_mkh100a, NOT in canoe modules.load
# — skipped here.)
ccflags-y += -I$(src)
ccflags-y += -DCONFIG_OPLUS_MAGCVR_NOTIFY

# OEM source has compatible-string initializers exactly matching
# i2c_device_id::name's size (20 chars) so the null terminator is
# elided. Newer clang flags this with -Werror=unterminated-string-
# initialization. OEM presumably built with an older toolchain or
# specific suppression. Match OEM behavior bug-for-bug rather than
# patch the strings (which would change the runtime compatible).
ccflags-y += -Wno-error=unterminated-string-initialization

obj-m += oplus_magnetic_cover.o
oplus_magnetic_cover-y := magcvr_src/abstract/magnetic_cover_core.o

obj-m += oplus_magcvr_ak09973.o
oplus_magcvr_ak09973-y := magcvr_src/hardware/magcvr_ak09973.o

obj-m += oplus_magcvr_mxm1120.o
oplus_magcvr_mxm1120-y := magcvr_src/hardware/magcvr_mxm1120.o
