# SPDX-License-Identifier: GPL-2.0-only
# Touch cluster dispatcher: 22 modules from one M= dir.
# Internal symvers (e.g. tp_custom -> tp_common -> vendor commons -> per-chip
# leaves) auto-merge because they all build under the same M= invocation.
# External deps (cmdline_parser, bootmode, projectinfo, device_info,
# tp_notify, fw_update) come in via KBUILD_EXTRA_SYMBOLS in Makefile.

ccflags-y += -I$(src) -I$(src)/touchpanel_notify
ccflags-y += -DCONFIG_TOUCHPANEL_NOTIFY \
             -DCONFIG_TOUCHPANEL_OPLUS_MODULE \
             -DCONFIG_QCOM_PANEL_EVENT_NOTIFIER \
             -DCONFIG_OPLUS_FEATURE_OPROJECT

# --- Foundation tier ---

obj-m += oplus_bsp_tp_custom.o
oplus_bsp_tp_custom-y := touch_custom/touch.o

obj-m += oplus_bsp_tp_common.o
oplus_bsp_tp_common-y := \
    util_interface/touch_interfaces.o \
    touch_comon_api/touch_comon_api.o \
    touchpanel_healthinfo/touchpanel_healthinfo.o \
    touchpanel_healthinfo/touchpanel_exception.o \
    touchpanel_autotest/touchpanel_autotest.o \
    touchpanel_prevention/touchpanel_prevention.o \
    touchpanel_common_driver.o \
    touchpanel_proc.o \
    tp_ioctl.o \
    touchpanel_tui_support/touchpanel_tui_support.o \
    message_list.o \
    touch_pen/touch_pen_core.o \
    touch_pen/touch_pen_algo.o

# --- Vendor common tier ---

