# Single-source module whose .c filename already matches the module
# name — use obj-m directly without $(MODULE)-objs to avoid a circular
# self-reference in kbuild's pattern rules.
#
# Cross-leaf symbol dependency: this module consumes uim_qmi_power_up_req
# and uim_qmi_power_down_req, both EXPORT_SYMBOL'd by oplus_network_oem_qmi.
# Kbuild's external-module flow does NOT auto-merge sibling-module
# Module.symvers — we must point at the producer's symvers explicitly so
# modpost can resolve the references. (Bazel handles this via ko_deps.)
EXTRA_CFLAGS += -DQCOM_PLATFORM
KBUILD_EXTRA_SYMBOLS += $(M)/../oplus_network_oem_qmi/Module.symvers
obj-m += oplus_network_esim.o
