LINUXINCLUDE    += -I$(EVA_ROOT)/include \
                   -I$(EVA_ROOT)/include/uapi \
				   -I$(EVA_ROOT)/include/uapi/eva

#srctree is /kernel_platform/common/

ccflags-y += -I$(EVA_ROOT)/msm/eva/ \
    -I$(srctree)/drivers/media/platform/msm/synx/

