ifeq ($(CONFIG_ARCH_PINEAPPLE), y)
$(info within KBUILD file CONFIG_ARCH_PINEAPPLE = $(CONFIG_ARCH_PINEAPPLE))
KBUILD_CPPFLAGS += -DCONFIG_EVA_PINEAPPLE=1 -DCVP_CONFIG_SYNX_V2=1
ccflags-y += -DCONFIG_EVA_PINEAPPLE=1 -DCVP_CONFIG_SYNX_V2=1
ccflags-y += -I$(EVA_ROOT)/../synx-kernel/msm/synx/ \
    -I$(EVA_ROOT)/../dsp-kernel/include/ \
    -I$(EVA_ROOT)/../synx-kernel/include/uapi/synx/media/
endif

# canoe (SM8850) — pineapple+SM8650 patterns plus canoe-specific fixups:
#   - dsp-kernel/include/linux/ for <fastrpc.h> (canoe enables
#     CVP_FASTRPC_ENABLED via CONFIG_EVA_CANOE in cvp_comm_def.h)
#   - -Wno-error=format on OEM hfi_response_handler.c (size_t printed
#     with %d at line 524; toolchain stricter than OEM's)
#   - extra source files always-compiled under canoe (the base
#     msm-eva-objs list above omits them):
#       eva/target/cvp_{pakala,kaanapali}_hal.o — referenced
#         unconditionally from cvp.c:405-408 (`set_*_hal_functions()`)
#       eva/msm_cvp_sw_dbg.o — provides eva_kmd_* symbols referenced
#         inside the CVP_SW_DBG_BUF_ENABLED-gated blocks (canoe sets
#         CVP_SW_DBG_BUF_ENABLED=1 via cvp_comm_def.h)
ifeq ($(CONFIG_ARCH_CANOE), y)
$(info within KBUILD file CONFIG_ARCH_CANOE = $(CONFIG_ARCH_CANOE))
KBUILD_CPPFLAGS += -DCONFIG_EVA_CANOE=1 -DCVP_CONFIG_SYNX_V2=1
ccflags-y += -DCONFIG_EVA_CANOE=1 -DCVP_CONFIG_SYNX_V2=1
ccflags-y += -I$(EVA_ROOT)/../synx-kernel/msm/synx/ \
    -I$(EVA_ROOT)/../dsp-kernel/include/ \
    -I$(EVA_ROOT)/../dsp-kernel/include/linux/ \
    -I$(EVA_ROOT)/../synx-kernel/include/uapi/synx/media/
ccflags-y += -Wno-error=format
endif


ifeq ($(CONFIG_EVA_LE), 1)
ccflags-y += -DCONFIG_EVA_TVM=1
endif

