        eva/msm_cvp_common.o \
        eva/msm_cvp_core.o \
        eva/msm_cvp.o \
        eva/cvp_smem.o \
        eva/msm_cvp_debug.o \
        eva/msm_cvp_res_parse.o \
        eva/cvp_dump.o \
        eva/cvp_hfi.o \
        eva/hfi_response_handler.o \
        eva/hfi_packetization.o \
        eva/cvp_core_hfi.o \
        eva/msm_cvp_clocks.o\
        eva/msm_cvp_dsp.o \
        eva/msm_cvp_buf.o \
        eva/msm_cvp_synx.o \
	eva/cvp_fw_load.o \
	eva/cvp_power.o \
	eva/cvp_presil.o \
	eva/vm/cvp_vm_main.o \
	eva/vm/cvp_vm_msgq.o \
	eva/vm/cvp_vm_resource.o

# canoe-specific obj additions (must come AFTER the base
# `msm-eva-objs :=` above, since that uses `:=` which would
# overwrite an earlier `+=`). Three SoC-conditional sources:
#   target/cvp_pakala_hal.o + target/cvp_kaanapali_hal.o — referenced
#     unconditionally from cvp.c's set_*_hal_functions() calls
#     (lines 405-408); compile under canoe's hal_version dispatch.
#   msm_cvp_sw_dbg.o — provides eva_kmd_* symbols referenced inside
#     #ifdef CVP_SW_DBG_BUF_ENABLED blocks (canoe sets that define
#     via cvp_comm_def.h's CONFIG_EVA_CANOE block).
ifeq ($(CONFIG_ARCH_CANOE), y)
msm-eva-objs += eva/target/cvp_pakala_hal.o \
                eva/target/cvp_kaanapali_hal.o \
                eva/msm_cvp_sw_dbg.o
endif

obj-m += msm-eva.o

